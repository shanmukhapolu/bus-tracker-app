# Copy to .env.staging.local. Obtain a SEPARATE project only after approval.
# Replace every placeholder with that project's own web-app configuration.
VITE_ENVIRONMENT=staging
VITE_FIREBASE_PROJECT_ID=replace-with-staging-project
VITE_FIREBASE_AUTH_DOMAIN=replace-with-staging-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://replace-with-staging-project-default-rtdb.firebaseio.com
VITE_FIREBASE_API_KEY=replace-with-staging-web-api-key
VITE_FIREBASE_APP_ID=replace-with-staging-app-id
VITE_FIREBASE_HOSTING_SITE=replace-with-staging-project
VITE_TELEMETRY_MODE=legacy
VITE_TELEMETRY_API_BASE_URL=
