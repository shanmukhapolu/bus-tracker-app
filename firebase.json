{
  "hosting": {
    "public": "dist",
    "predeploy": [
      "node scripts/deployment-guard.mjs production hosting"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(self)"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://i.postimg.cc https://*.openfreemap.org; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://www.gstatic.com https://*.openfreemap.org; frame-src https://chsbustracker2.firebaseapp.com; worker-src 'self' blob:; font-src 'self' data: https://fonts.gstatic.com https://*.openfreemap.org"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|woff2|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/admin/map{,/}",
        "destination": "https://chsbustracker2-admin.web.app/map",
        "type": 302
      },
      {
        "source": "/admin/buses{,/}",
        "destination": "https://chsbustracker2-admin.web.app/buses",
        "type": 302
      },
      {
        "source": "/admin/drivers{,/}",
        "destination": "https://chsbustracker2-admin.web.app/drivers",
        "type": 302
      },
      {
        "source": "/admin/devices{,/}",
        "destination": "https://chsbustracker2-admin.web.app/devices",
        "type": 302
      },
      {
        "source": "/admin/events{,/}",
        "destination": "https://chsbustracker2-admin.web.app/events",
        "type": 302
      },
      {
        "source": "/admin/history{,/}",
        "destination": "https://chsbustracker2-admin.web.app/history",
        "type": 302
      },
      {
        "source": "/admin/geofences{,/**}",
        "destination": "https://chsbustracker2-admin.web.app/geofences",
        "type": 302
      },
      {
        "source": "/bus/:busId",
        "destination": "https://chsbustracker2-admin.web.app/buses/:busId",
        "type": 302
      },
      {
        "source": "/admin{,/**}",
        "destination": "https://chsbustracker2-admin.web.app/",
        "type": 302
      }
    ]
  }
}
